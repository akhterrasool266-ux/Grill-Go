# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key           # public by design; RLS protects the data
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                                          # random 32+ chars; protects /api/cron/*

# ── Messaging providers (leave blank = provider disabled; nothing is faked) ───
# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=                                # you choose; used for webhook verification
WHATSAPP_APP_SECRET=                                  # verifies webhook signatures
# SMS (generic HTTP gateway — adapt src/lib/notify/providers/sms-http.ts to your vendor)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="School <no-reply@example.com>"
# Web push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Payment gateways (enable by filling in; webhooks verified server-side) ────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Easypaisa is intentionally NOT enabled until its callback can be verified (see docs/payments.md)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# ── AI assistant (optional) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
